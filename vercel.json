{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/public/:path*",
      "destination": "https://die2hard-studio.onrender.com/api/public/:path*"
    },
    {
      "source": "/work/:slug",
      "destination": "/work/project"
    },
    {
      "source": "/pt/work/:slug",
      "destination": "/pt/work/project"
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/process",
      "destination": "/studio",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
